generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id            Int      @id @default(1)
  name          String   @default("Usuario")
  monthlyIncome Decimal  @default(0) @db.Decimal(12, 2)
  currency      String   @default("MXN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  spendingAllocations SpendingAllocation[]
}

model SpendingAllocation {
  id         Int     @id @default(autoincrement())
  profileId  Int
  label      String
  percentage Decimal @db.Decimal(5, 2)
  sortOrder  Int     @default(0)

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model CreditCard {
  id                  Int      @id @default(autoincrement())
  name                String
  bankName            String?
  cutOffDay           Int
  paymentDueDay       Int
  preferredPaymentDay Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  debts      Debt[]
  statements Statement[]
}

model Debt {
  id              Int        @id @default(autoincrement())
  name            String
  sourceType      DebtSource @default(MANUAL)
  totalAmount     Decimal?   @db.Decimal(12, 2)
  monthlyAmount   Decimal    @db.Decimal(12, 2)
  months          Int?
  remainingMonths Int?
  startDate       DateTime   @default(now())
  endDate         DateTime?
  isRecurring     Boolean    @default(false)
  paymentDay      Int
  creditCardId    Int?
  notes           String?
  isPaidOff       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  creditCard CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
}

model Statement {
  id               Int      @id @default(autoincrement())
  creditCardId     Int?
  statementDate    DateTime
  fileName         String
  originalFilePath String
  parsedText       String?
  createdAt        DateTime @default(now())

  creditCard CreditCard?         @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  purchases  StatementPurchase[]
}

model StatementPurchase {
  id                 Int       @id @default(autoincrement())
  statementId        Int
  description        String
  purchaseDate       DateTime?
  totalAmount        Decimal?  @db.Decimal(12, 2)
  monthlyAmount      Decimal   @db.Decimal(12, 2)
  totalMonths        Int?
  currentInstallment Int?
  remainingMonths    Int?
  isInterestFree     Boolean   @default(false)
  createdAt          DateTime  @default(now())

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}

model PaymentPeriodSnapshot {
  id          Int      @id @default(autoincrement())
  periodKey   String   @unique
  periodStart DateTime
  periodEnd   DateTime
  periodLabel String
  income      Decimal  @db.Decimal(12, 2)
  currency    String   @default("MXN")
  totalToPay  Decimal  @db.Decimal(12, 2)
  balance     Decimal  @db.Decimal(12, 2)
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PaymentPeriodSnapshotItem[]
  allocations PaymentPeriodSnapshotAllocation[]
}

model PaymentPeriodSnapshotAllocation {
  id               Int     @id @default(autoincrement())
  periodSnapshotId Int
  label            String
  percentage       Decimal @db.Decimal(5, 2)
  sortOrder        Int     @default(0)

  periodSnapshot PaymentPeriodSnapshot @relation(fields: [periodSnapshotId], references: [id], onDelete: Cascade)

  @@index([periodSnapshotId, sortOrder])
}

model PaymentPeriodSnapshotItem {
  id               Int      @id @default(autoincrement())
  periodSnapshotId Int
  debtId           Int?
  bucketKey        String
  paymentDate      DateTime
  paymentDay       Int
  paymentLabel     String
  debtName         String
  cardName         String?
  amount           Decimal  @db.Decimal(12, 2)
  isRecurring      Boolean  @default(false)
  progressLabel    String
  remainingLabel   String?
  createdAt        DateTime @default(now())

  periodSnapshot PaymentPeriodSnapshot @relation(fields: [periodSnapshotId], references: [id], onDelete: Cascade)

  @@index([periodSnapshotId, bucketKey])
}

enum DebtSource {
  MANUAL
  STATEMENT
  RECURRING
}
